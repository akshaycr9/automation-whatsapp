// QW Automations placeholder Prisma schema.
// Final business models will be added during the database design phase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TemplateType {
  TEXT
  MEDIA
  CAROUSEL
  AUTHENTICATION
}

enum TemplateCategory {
  UTILITY
  MARKETING
  AUTHENTICATION
}

enum TemplateStatus {
  DRAFT
  SUBMITTING
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
  DELETED
  ERROR
}

enum TemplateComponentType {
  HEADER
  BODY
  FOOTER
  BUTTONS
  CAROUSEL
}

enum TemplateHeaderFormat {
  NONE
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
  LOCATION
}

enum TemplateButtonType {
  QUICK_REPLY
  URL
  PHONE_NUMBER
  COPY_CODE
  FLOW
}

enum TemplateQualityRating {
  GREEN
  YELLOW
  RED
  UNKNOWN
}

enum TemplateProvider {
  META
}

enum TemplateProviderAction {
  CREATE
  UPDATE
  DELETE
  SYNC
  WEBHOOK
}

enum TemplateEventType {
  CREATED
  SUBMITTED
  APPROVED
  REJECTED
  PAUSED
  DISABLED
  SYNCED
  DELETED
  WEBHOOK_RECEIVED
  ERROR
}

enum AutomationFlowKey {
  ORDER_FLOW
  COD_FLOW
  ABANDONED_CART_FLOW
}

enum AutomationKey {
  ORDER_CONFIRMED
  ORDER_FULFILLED
  ORDER_CANCELLED
  COD_ORDER_CONFIRMATION
  COD_ORDER_CONFIRMED
  COD_ORDER_CANCELLED
  COD_ORDER_FOLLOW_UP
  ABANDONED_CART_1
  ABANDONED_CART_2
  ABANDONED_CART_3
}

enum AutomationTriggerSource {
  SHOPIFY
  WHATSAPP
  SYSTEM
}

enum AutomationTriggerEvent {
  ORDER_CREATED
  ORDER_FULFILLED
  ORDER_CANCELLED
  COD_ORDER_CREATED
  CHECKOUT_ABANDONED
  BUTTON_REPLY
}

enum AutomationResourceType {
  ORDER
  CHECKOUT
  CUSTOMER
}

enum AutomationJobStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
  CANCELLED
}

enum AutomationComponentType {
  HEADER
  BODY
  BUTTON
}

enum AutomationActionStateValue {
  PENDING_CONFIRMATION
  CONFIRMED
  CANCELLED
  FOLLOW_UP_SENT
  ABANDONED_ACTIVE
  RECOVERED
  EXPIRED
}

model Placeholder {
  id        String   @id @default(cuid())
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id               String                  @id @default(cuid())
  email            String                  @unique
  passwordHash     String
  isActive         Boolean                 @default(true)
  failedLoginCount Int                     @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  refreshSessions  RefreshSession[]
  templates        WhatsAppTemplate[]      @relation("TemplateTenant")
  createdTemplates WhatsAppTemplate[]      @relation("TemplateCreatedBy")
  updatedTemplates WhatsAppTemplate[]      @relation("TemplateUpdatedBy")
  templateEvents   WhatsAppTemplateEvent[] @relation("TemplateEventCreatedBy")

  @@index([isActive])
}

model RefreshSession {
  id          String    @id @default(cuid())
  adminUserId String
  deviceId    String
  tokenHash   String    @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, deviceId])
  @@index([adminUserId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model WhatsAppTemplate {
  id                  String                            @id @default(cuid())
  adminUserId         String
  wabaId              String?
  metaTemplateId      String?
  name                String
  displayName         String?
  category            TemplateCategory
  type                TemplateType
  languageCode        String
  status              TemplateStatus                    @default(DRAFT)
  qualityRating       TemplateQualityRating             @default(UNKNOWN)
  rejectionReason     String?
  allowCategoryChange Boolean                           @default(false)
  lastSyncedAt        DateTime?
  createdById         String?
  updatedById         String?
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt
  deletedAt           DateTime?
  adminUser           AdminUser                         @relation("TemplateTenant", fields: [adminUserId], references: [id], onDelete: Cascade)
  createdBy           AdminUser?                        @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           AdminUser?                        @relation("TemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  components          WhatsAppTemplateComponent[]
  variables           WhatsAppTemplateVariable[]
  buttons             WhatsAppTemplateButton[]
  providerPayloads    WhatsAppTemplateProviderPayload[]
  events              WhatsAppTemplateEvent[]
  automations         Automation[]

  @@unique([adminUserId, name, languageCode])
  @@index([adminUserId, status])
  @@index([adminUserId, category])
  @@index([adminUserId, type])
  @@index([adminUserId, languageCode])
  @@index([metaTemplateId])
  @@index([wabaId])
  @@index([deletedAt])
}

model WhatsAppTemplateComponent {
  id            String                     @id @default(cuid())
  templateId    String
  componentType TemplateComponentType
  format        TemplateHeaderFormat?
  text          String?
  sortOrder     Int                        @default(0)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  template      WhatsAppTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  variables     WhatsAppTemplateVariable[]
  buttons       WhatsAppTemplateButton[]

  @@unique([templateId, componentType, sortOrder])
  @@index([templateId])
}

model WhatsAppTemplateVariable {
  id            String                     @id @default(cuid())
  templateId    String
  componentId   String?
  componentType TemplateComponentType
  position      Int
  placeholder   String
  label         String?
  sampleValue   String
  sourceKey     String?
  fallbackValue String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  template      WhatsAppTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  component     WhatsAppTemplateComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)

  @@unique([templateId, componentType, position])
  @@index([templateId])
  @@index([componentId])
}

model WhatsAppTemplateButton {
  id          String                     @id @default(cuid())
  templateId  String
  componentId String?
  buttonType  TemplateButtonType
  text        String
  url         String?
  phoneNumber String?
  payload     String?
  flowId      String?
  sortOrder   Int                        @default(0)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  template    WhatsAppTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  component   WhatsAppTemplateComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)

  @@unique([templateId, sortOrder])
  @@index([templateId])
  @@index([componentId])
}

model WhatsAppTemplateProviderPayload {
  id              String                 @id @default(cuid())
  templateId      String?
  provider        TemplateProvider       @default(META)
  action          TemplateProviderAction
  requestPayload  Json?
  responsePayload Json?
  statusCode      Int?
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime               @default(now())
  template        WhatsAppTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@index([provider, action])
  @@index([createdAt])
}

model WhatsAppTemplateEvent {
  id          String            @id @default(cuid())
  templateId  String?
  eventType   TemplateEventType
  oldStatus   TemplateStatus?
  newStatus   TemplateStatus?
  message     String?
  metadata    Json?
  createdById String?
  createdAt   DateTime          @default(now())
  template    WhatsAppTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy   AdminUser?        @relation("TemplateEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@index([eventType])
  @@index([createdAt])
}

model AutomationFlow {
  id          String            @id @default(cuid())
  key         AutomationFlowKey @unique
  name        String
  description String
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  automations Automation[]

  @@index([sortOrder])
}

model Automation {
  id                  String                      @id @default(cuid())
  flowId              String
  key                 AutomationKey               @unique
  name                String
  description         String
  triggerSource       AutomationTriggerSource
  triggerEvent        AutomationTriggerEvent
  isEnabled           Boolean                     @default(false)
  templateId          String?
  delayMinutes        Int                         @default(0)
  sortOrder           Int                         @default(0)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  flow                AutomationFlow              @relation(fields: [flowId], references: [id], onDelete: Cascade)
  template            WhatsAppTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  variableMappings    AutomationVariableMapping[]
  sourceButtonActions AutomationButtonAction[]    @relation("AutomationButtonActionSource")
  targetButtonActions AutomationButtonAction[]    @relation("AutomationButtonActionTarget")
  jobs                AutomationJob[]

  @@index([flowId, sortOrder])
  @@index([triggerSource, triggerEvent])
  @@index([isEnabled])
  @@index([templateId])
}

model AutomationVariableMapping {
  id                   String                  @id @default(cuid())
  automationId         String
  templateVariableName String
  componentType        AutomationComponentType
  variableIndex        Int
  sourceField          String
  fallbackValue        String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  automation           Automation              @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, componentType, variableIndex])
  @@index([automationId])
}

model AutomationButtonAction {
  id                 String                 @id @default(cuid())
  sourceAutomationId String
  targetAutomationId String
  actionKey          String
  buttonText         String
  payloadPrefix      String                 @unique
  resourceType       AutomationResourceType
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  sourceAutomation   Automation             @relation("AutomationButtonActionSource", fields: [sourceAutomationId], references: [id], onDelete: Cascade)
  targetAutomation   Automation             @relation("AutomationButtonActionTarget", fields: [targetAutomationId], references: [id], onDelete: Cascade)

  @@index([sourceAutomationId])
  @@index([targetAutomationId])
  @@index([actionKey])
  @@index([isActive])
}

model IncomingEvent {
  id              String                  @id @default(cuid())
  source          AutomationTriggerSource
  eventType       AutomationTriggerEvent
  externalEventId String?
  resourceType    AutomationResourceType
  resourceId      String
  customerPhone   String?
  payloadJson     Json
  receivedAt      DateTime                @default(now())
  processedAt     DateTime?
  isProcessed     Boolean                 @default(false)
  errorMessage    String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  jobs            AutomationJob[]
  actionStates    AutomationActionState[]

  @@unique([source, externalEventId])
  @@index([source, eventType])
  @@index([resourceType, resourceId])
  @@index([customerPhone])
  @@index([isProcessed])
}

model AutomationJob {
  id              String                 @id @default(cuid())
  automationId    String
  incomingEventId String
  resourceType    AutomationResourceType
  resourceId      String
  customerPhone   String?
  scheduledAt     DateTime
  status          AutomationJobStatus    @default(PENDING)
  bullmqJobId     String?
  idempotencyKey  String                 @unique
  attemptCount    Int                    @default(0)
  lastError       String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  automation      Automation             @relation(fields: [automationId], references: [id], onDelete: Cascade)
  incomingEvent   IncomingEvent          @relation(fields: [incomingEventId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([incomingEventId])
  @@index([resourceType, resourceId])
  @@index([status])
  @@index([scheduledAt])
  @@index([bullmqJobId])
}

model AutomationActionState {
  id            String                     @id @default(cuid())
  flowKey       AutomationFlowKey
  resourceType  AutomationResourceType
  resourceId    String
  customerPhone String?
  state         AutomationActionStateValue
  sourceEventId String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  sourceEvent   IncomingEvent?             @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)

  @@unique([flowKey, resourceType, resourceId])
  @@index([state])
  @@index([customerPhone])
  @@index([sourceEventId])
}
