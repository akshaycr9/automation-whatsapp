// QW Automations placeholder Prisma schema.
// Final business models will be added during the database design phase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Placeholder {
  id        String   @id @default(cuid())
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
